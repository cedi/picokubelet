# Copy to .env and fill in. .env is gitignored.
# All values are baked into the firmware at compile time via env!().
# Re-flash after changing.

# k3s control plane
K3S_API_HOST=192.168.0.103
K3S_API_PORT=6443
K3S_TOKEN=replace-me-with-your-k3s-bearer-token

# Wi-Fi (used during early development; switching to W5500 ethernet later)
WIFI_SSID=replace-me
WIFI_PSK=replace-me

# Node identity. Optional — defaults to esp-node-01-guenther if unset.
# Must be a valid k8s name: lowercase letters, digits, dots, hyphens.
NODE_NAME=esp-node-01-guenther
